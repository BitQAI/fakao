[Unit]
Description=Fakao Frontend (Next.js standalone)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/fakao/frontend
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/fakao/frontend/.next/standalone/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
