# Backend Dockerfile
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies - use faster mirrors and minimal packages
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true && \
    apt-get update && apt-get install -y --no-install-recommends ffmpeg curl && \
    rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY backend/requirements.txt .
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple && pip install --no-cache-dir -r requirements.txt

# Copy backend application and scripts
COPY backend/app ./app
COPY backend/scripts ./scripts

# Ensure scripts directory is in Python path
ENV PYTHONPATH=/app:/app/scripts

# Expose port
EXPOSE 8000

# Run the application
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]